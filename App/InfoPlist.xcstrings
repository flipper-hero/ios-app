    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل FlipperHero بجهاز Flipper Zero عبر البلوتوث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero verbindet sich per Bluetooth mit deinem Flipper Zero."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FlipperHero connects to your Flipper Zero over Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero se conecta a tu Flipper Zero por Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero se connecte à ton Flipper Zero en Bluetooth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero ब्लूटूथ से आपके Flipper Zero से जुड़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero si collega al tuo Flipper Zero tramite Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero は Bluetooth で Flipper Zero に接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero는 블루투스로 Flipper Zero에 연결합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero łączy się z Twoim Flipperem Zero przez Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FlipperHero se conecta ao seu Flipper Zero por Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero подключается к вашему Flipper Zero по Bluetooth."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero, Flipper Zero’na Bluetooth ile bağlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero підключається до вашого Flipper Zero через Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlipperHero 通过蓝牙连接你的 Flipper Zero。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرِ الوكيل جهاز تحكم أو ملصقًا أو جهازًا ليساعدك في التعرف عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig dem Agenten eine Fernbedienung, ein Etikett oder ein Gerät, damit er es erkennen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the agent a remote, a label or a device so it can help identify it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enseña al agente un mando, una etiqueta o un dispositivo para que ayude a identificarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre à l’agent une télécommande, une étiquette ou un appareil pour qu’il aide à l’identifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट को रिमोट, लेबल या डिवाइस दिखाएँ ताकि वह उसे पहचानने में मदद कर सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra all’agente un telecomando, un’etichetta o un dispositivo così può aiutarti a identificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコン、ラベル、デバイスをエージェントに見せて、識別を手伝ってもらいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트에게 리모컨, 라벨, 기기를 보여 주면 식별을 도와줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż agentowi pilota, etykietę lub urządzenie, aby pomógł je rozpoznać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre ao agente um controle, uma etiqueta ou um dispositivo para ele ajudar a identificar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите агенту пульт, наклейку или устройство, чтобы он помог его определить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanın tanımasına yardımcı olmak için ona bir kumanda, etiket veya aygıt göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажіть агенту пульт, наклейку чи пристрій, щоб він допоміг його визначити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给智能体看遥控器、标签或设备，帮助识别它。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث إلى الوكيل بدل الكتابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich mit dem Agenten, statt zu tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speak to the agent instead of typing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla con el agente en lugar de escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle à l’agent au lieu de taper."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइप करने के बजाय एजेंट से बोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parla con l’agente invece di scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力の代わりにエージェントに話しかけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 대신 에이전트에게 말하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mów do agenta zamiast pisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale com o agente em vez de digitar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите с агентом вместо набора текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmak yerine ajanla konuş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говоріть з агентом замість набору тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用语音代替打字与智能体交流。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
