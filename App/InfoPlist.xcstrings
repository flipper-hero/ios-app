          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함의 사진을 메시지에 첨부합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do wiadomości obraz z biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexar uma imagem da sua fototeca a uma mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепить к сообщению фото из медиатеки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivinden bir resmi mesaja ekle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати до повідомлення зображення з медіатеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从图库中选取图片附加到消息。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحوَّل رسالتك المنطوقة إلى نص للوكيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gesprochene Nachricht wird für den Agenten in Text umgewandelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your spoken message is turned into text for the agent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mensaje de voz se convierte en texto para el agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton message vocal est transformé en texte pour l’agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका बोला गया संदेश एजेंट के लिए टेक्स्ट में बदला जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo messaggio vocale viene trasformato in testo per l’agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容はエージェント用のテキストに変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 메시지가 에이전트를 위한 텍스트로 변환됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja wiadomość głosowa jest zamieniana na tekst dla agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mensagem falada é convertida em texto para o agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше голосовое сообщение превращается в текст для агента."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli mesajın ajan için metne dönüştürülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше голосове повідомлення перетворюється на текст для агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的语音消息会转换成文字发给智能体。"
          }
        }
      }
