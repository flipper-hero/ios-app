          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joindre une image de ta photothèque à un message."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी लाइब्रेरी से कोई तस्वीर संदेश में जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
