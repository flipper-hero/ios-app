    "At most %lld characters: letters, digits, hyphen, underscore. It takes effect after the Flipper restarts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld أحرف كحد أقصى: حروف وأرقام وشرطة وشرطة سفلية. يسري بعد إعادة تشغيل Flipper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens %lld Zeichen: Buchstaben, Ziffern, Bindestrich, Unterstrich. Gilt nach einem Neustart des Flippers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como máximo %lld caracteres: letras, dígitos, guion y guion bajo. Se aplica tras reiniciar el Flipper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld caractères maximum : lettres, chiffres, tiret, tiret bas. Pris en compte après le redémarrage du Flipper."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम %lld अक्षर: अक्षर, अंक, हाइफ़न, अंडरस्कोर। Flipper रीस्टार्ट होने के बाद लागू होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al massimo %lld caratteri: lettere, cifre, trattino, trattino basso. Vale dopo il riavvio del Flipper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 %lld 文字：英字、数字、ハイフン、アンダースコア。Flipper の再起動後に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 %lld자: 영문자, 숫자, 하이픈, 밑줄. Flipper를 재시동하면 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyżej %lld znaków: litery, cyfry, myślnik, podkreślnik. Obowiązuje po ponownym uruchomieniu Flippera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No máximo %lld caracteres: letras, dígitos, hífen, sublinhado. Vale após reiniciar o Flipper."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не более %lld символов: буквы, цифры, дефис, подчёркивание. Применяется после перезагрузки Flipper."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla %lld karakter: harf, rakam, kısa çizgi, alt çizgi. Flipper yeniden başlayınca geçerli olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не більше %lld символів: літери, цифри, дефіс, підкреслення. Діє після перезапуску Flipper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 %lld 个字符：字母、数字、连字符、下划线。Flipper 重启后生效。"
          }
        }
      }
    },
