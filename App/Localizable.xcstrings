    "Whatever runs on the Flipper stops. The app reconnects on its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف كل ما يعمل على Flipper. يعيد التطبيق الاتصال بنفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gerade auf dem Flipper läuft, wird beendet. Die App verbindet sich selbst wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se ejecuta en el Flipper se detiene. La app se vuelve a conectar sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui tourne sur le Flipper s’arrête. L’app se reconnecte toute seule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper पर जो चल रहा है, वह रुक जाएगा। ऐप खुद फिर से कनेक्ट हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che è in esecuzione sul Flipper si ferma. L’app si ricollega da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper で実行中のものは停止します。アプリは自動で再接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper에서 실행 중인 것이 중지됩니다. 앱은 자동으로 다시 연결합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co działa na Flipperze, zostanie zatrzymane. Aplikacja połączy się sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que estiver rodando no Flipper para. O app reconecta sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что запущено на Flipper, остановится. Приложение подключится само."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper’da çalışan her şey durur. Uygulama kendiliğinden yeniden bağlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, що запущено на Flipper, зупиниться. Застосунок підключиться сам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper 上正在运行的内容将停止。App 会自动重新连接。"
          }
        }
      }
    },
