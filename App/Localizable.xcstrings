    "No Flipper found yet. Turn Bluetooth on at the Flipper (Settings > Bluetooth) and keep it unlocked and close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على Flipper بعد. فعّل البلوتوث على Flipper (Settings > Bluetooth) وأبقه غير مقفل وقريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Flipper gefunden. Schalte Bluetooth am Flipper ein (Settings > Bluetooth) und halte ihn entsperrt und in der Nähe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha encontrado ningún Flipper. Activa el Bluetooth en el Flipper (Settings > Bluetooth) y mantenlo desbloqueado y cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun Flipper trouvé pour l’instant. Active le Bluetooth sur le Flipper (Settings > Bluetooth), garde-le déverrouillé et à proximité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कोई Flipper नहीं मिला। Flipper पर ब्लूटूथ चालू करें (Settings > Bluetooth) और उसे अनलॉक और पास रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun Flipper trovato finora. Attiva il Bluetooth sul Flipper (Settings > Bluetooth) e tienilo sbloccato e vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper がまだ見つかりません。Flipper の Bluetooth をオンにして（Settings > Bluetooth）、ロックを解除したまま近くに置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 Flipper를 찾지 못했습니다. Flipper에서 블루투스를 켜고(Settings > Bluetooth) 잠금 해제한 채 가까이 두세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono jeszcze Flippera. Włącz Bluetooth na Flipperze (Settings > Bluetooth), trzymaj go odblokowanego i blisko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum Flipper encontrado ainda. Ative o Bluetooth no Flipper (Settings > Bluetooth) e mantenha-o desbloqueado e por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper пока не найден. Включите Bluetooth на Flipper (Settings > Bluetooth), не блокируйте его и держите рядом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz Flipper bulunamadı. Flipper’da Bluetooth’u aç (Settings > Bluetooth), kilidini açık ve yakında tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper ще не знайдено. Увімкніть Bluetooth на Flipper (Settings > Bluetooth), не блокуйте його й тримайте поруч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未找到 Flipper。请在 Flipper 上开启蓝牙（Settings > Bluetooth），并保持解锁和靠近。"
          }
        }
      }
    },
