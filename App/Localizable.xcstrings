    "Your Flipper already runs %@. This flashes the same release again, which can repair a broken install." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Flipper بالفعل بـ %@. سيُعاد تثبيت الإصدار نفسه، وقد يصلح ذلك تثبيتًا تالفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Flipper läuft bereits %@. Das spielt dieselbe Version erneut auf und kann eine beschädigte Installation reparieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Flipper ya ejecuta %@. Esto vuelve a instalar la misma versión, lo que puede reparar una instalación dañada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Flipper exécute déjà %@. Cela réinstalle la même version, ce qui peut réparer une installation endommagée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके Flipper पर पहले से %@ चल रहा है। यह वही रिलीज़ फिर से फ़्लैश करता है, जिससे टूटा इंस्टॉलेशन ठीक हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Flipper ha già %@. Così si reinstalla la stessa versione, utile per riparare un’installazione danneggiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper はすでに %@ です。同じリリースを書き込み直すことで、壊れたインストールを修復できる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper가 이미 %@을(를) 실행 중입니다. 같은 릴리스를 다시 설치하면 손상된 설치를 복구할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Flipper ma już %@. To ponownie wgra to samo wydanie, co może naprawić uszkodzoną instalację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Flipper já roda %@. Isso grava a mesma versão de novo, o que pode reparar uma instalação com defeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем Flipper уже стоит %@. Это повторно установит ту же версию и может исправить повреждённую установку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper’ında zaten %@ var. Bu aynı sürümü yeniden yükler; bozuk bir kurulumu onarabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашому Flipper уже %@. Це повторно встановить ту саму версію й може виправити пошкоджене встановлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Flipper 已在运行 %@。这会重新刷写同一版本，可以修复损坏的安装。"
          }
        }
      }
    },
    "Your Flipper runs a development build. This installs the newest published release instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Flipper بإصدار تطوير. سيُثبَّت بدلًا منه أحدث إصدار منشور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Flipper läuft ein Entwickler-Build. Hiermit wird stattdessen die neueste veröffentlichte Version installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Flipper ejecuta una versión de desarrollo. Esto instala en su lugar la última versión publicada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Flipper exécute un build de développement. Cela installe à la place la dernière version publiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके Flipper पर डेवलपमेंट बिल्ड चल रहा है। इसके बजाय नवीनतम प्रकाशित रिलीज़ इंस्टॉल होगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Flipper ha una build di sviluppo. Così viene installata invece l’ultima versione pubblicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper は開発ビルドで動作しています。代わりに最新の公開リリースをインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper가 개발 빌드를 실행 중입니다. 대신 최신 공개 릴리스를 설치합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Flipper ma wersję deweloperską. Zamiast niej zostanie zainstalowane najnowsze opublikowane wydanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Flipper roda um build de desenvolvimento. Isso instala a versão publicada mais recente no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем Flipper сборка для разработчиков. Вместо неё будет установлена последняя опубликованная версия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipper’ında bir geliştirici derlemesi var. Bunun yerine yayınlanmış en yeni sürüm yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашому Flipper збірка для розробників. Натомість буде встановлено найновішу опубліковану версію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Flipper 运行的是开发版。这会改为安装最新的正式版本。"
          }
        }
      }
    },
