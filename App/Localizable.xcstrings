    "Emulates a saved NFC card, 125 kHz tag or iButton key on your Flipper until you stop it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحاكي على Flipper بطاقة NFC أو وسم 125 كيلوهرتز أو مفتاح iButton محفوظًا حتى توقفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuliert eine gespeicherte NFC-Karte, einen 125-kHz-Tag oder einen iButton-Schlüssel auf deinem Flipper, bis du stoppst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emula en tu Flipper una tarjeta NFC, una etiqueta de 125 kHz o una llave iButton guardadas hasta que lo detengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émule une carte NFC, un badge 125 kHz ou une clé iButton enregistrés sur ton Flipper jusqu’à ce que tu l’arrêtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके रोकने तक आपके Flipper पर सहेजा गया NFC कार्ड, 125 kHz टैग या iButton कुंजी एमुलेट करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emula sul tuo Flipper una carta NFC, un tag a 125 kHz o una chiave iButton salvati finché non la fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの NFC カード、125 kHz タグ、iButton キーを、停止するまで Flipper でエミュレートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 NFC 카드, 125kHz 태그 또는 iButton 키를 중지할 때까지 Flipper에서 에뮬레이트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuluje na Flipperze zapisaną kartę NFC, tag 125 kHz lub klucz iButton, dopóki nie zatrzymasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emula no seu Flipper um cartão NFC, uma tag de 125 kHz ou uma chave iButton salvos até você parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмулирует на Flipper сохранённую NFC-карту, метку 125 кГц или ключ iButton, пока вы не остановите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı bir NFC kartını, 125 kHz etiketi veya iButton anahtarını sen durdurana kadar Flipper’ında taklit eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емулює на вашому Flipper збережену NFC-картку, мітку 125 кГц або ключ iButton, доки ви не зупините."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的 Flipper 上模拟已保存的 NFC 卡、125 kHz 标签或 iButton 钥匙，直到你停止。"
          }
        }
      }
    },
