    "Could not reach %@. Is it on, nearby and Bluetooth enabled?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الوصول إلى %@. هل هو قيد التشغيل وقريب والبلوتوث مفعّل؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung zu %@. Ist er an, in der Nähe und Bluetooth aktiviert?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con %@. ¿Está encendido, cerca y con Bluetooth activado?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %@. Est-il allumé, à proximité et le Bluetooth activé ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तक नहीं पहुँच सके। क्या यह चालू, पास में और ब्लूटूथ सक्षम है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %@. È acceso, vicino e con il Bluetooth attivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に接続できません。電源が入っていて、近くにあり、Bluetooth がオンになっていますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결할 수 없습니다. 전원이 켜져 있고, 가까이 있으며, 블루투스가 켜져 있나요?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z %@. Czy jest włączony, blisko i ma włączony Bluetooth?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar %@. Ele está ligado, por perto e com Bluetooth ativado?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся связаться с %@. Он включён, рядом и Bluetooth включён?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cihazına ulaşılamadı. Açık, yakında ve Bluetooth’u etkin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається зв’язатися з %@. Він увімкнений, поруч і Bluetooth увімкнено?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 %@。它是否已开机、在附近并开启了蓝牙？"
