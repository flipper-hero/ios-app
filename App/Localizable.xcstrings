    "%@ on %@. Readers nearby see it until you stop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ على %2$@. تراها القارئات القريبة حتى توقفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ auf %2$@. Läuft für Lesegeräte in der Nähe, bis du stoppst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ on %2$@. Readers nearby see it until you stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@. Los lectores cercanos lo ven hasta que lo detengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sur %2$@. Visible par les lecteurs à proximité jusqu’à l’arrêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ पर %1$@। आपके रोकने तक पास के रीडर इसे देखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ su %2$@. I lettori vicini la vedono finché non la fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ で%1$@。停止するまで近くのリーダーから読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에서 %1$@. 중지할 때까지 주변 리더기가 읽을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ na %2$@. Pobliskie czytniki widzą ją, dopóki nie zatrzymasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ em %2$@. Leitores próximos a veem até você parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ на %2$@. Видно ближайшим считывателям, пока вы не остановите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
