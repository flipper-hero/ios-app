    "First time with this Flipper: confirm the same PIN on the phone and on the device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أول مرة مع هذا الـ Flipper: أكّد رمز PIN نفسه على الهاتف وعلى الجهاز."
          }
        },
        "de" : {
