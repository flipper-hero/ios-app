    "Shown on the banner and given to the agent, so it can tell what is in scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint im Banner und wird dem Agenten gegeben, damit es weiß, was im Rahmen liegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichée sur la bannière et donnée à l'agent pour qu'il sache ce qui est en périmètre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en la pancarta y se da al agente, para que sepa qué está dentro del alcance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrada na faixa e dada ao agente, para que ele saiba o que está no escopo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrata sul banner e data all'agente, così sa cosa rientra nel perimetro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается в баннере и передаётся агенту, чтобы он знал границы задания."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується в банері і передається агенту, щоб він знав межі завдання."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywana w banerze i przekazywana agentowi, żeby wiedział, co jest w zakresie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banner'da gösterilir ve ajana verilir, böylece neyin kapsam içinde olduğunu bilir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر في اللافتة وتُعطى للوكيل ليعرف ما هو داخل النطاق."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैनर पर दिखती है और एजेंट को दी जाती है, ताकि वह दायरा जान सके।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在横幅上并提供给智能体，让它知道什么在范围内。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バナーに表示され、エージェントにも渡されるので、範囲を把握できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배너에 표시되고 에이전트에게 전달되어 무엇이 범위 안인지 알 수 있습니다."
          }
        }
      }
    },
