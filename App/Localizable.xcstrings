    "Tap for a short press, hold for a long press. Hold Back to leave an app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر لضغطة قصيرة، واضغط مطولًا لضغطة طويلة. اضغط مطولًا على رجوع للخروج من تطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen für kurzen Druck, halten für langen Druck. Zurück halten, um eine App zu verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para una pulsación corta, mantén para una larga. Mantén Atrás para salir de una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche pour un appui court, maintiens pour un appui long. Maintiens Retour pour quitter une app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटे प्रेस के लिए टैप करें, लंबे प्रेस के लिए दबाए रखें। ऐप से बाहर निकलने के लिए Back दबाए रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per una pressione breve, tieni premuto per una lunga. Tieni premuto Indietro per uscire da un’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで短押し、長押しで長押し。アプリを終了するには「戻る」を長押しします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 짧게, 길게 누르면 길게 누릅니다. 앱에서 나가려면 뒤로를 길게 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, aby krótko nacisnąć, przytrzymaj, aby nacisnąć długo. Przytrzymaj Wstecz, aby wyjść z aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para um toque curto, segure para um longo. Segure Voltar para sair de um app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь для короткого нажатия, удерживайте для длинного. Удерживайте «Назад», чтобы выйти из приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa basış için dokun, uzun basış için basılı tut. Uygulamadan çıkmak için Geri’yi basılı tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться для короткого натискання, утримуйте для довгого. Утримуйте «Назад», щоб вийти із застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点为短按，按住为长按。按住返回键可退出应用。"
          }
        }
      }
    },
