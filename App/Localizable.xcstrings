    "Microphone or speech recognition permission is missing. Enable it in iOS Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذن الميكروفون أو التعرف على الكلام غير متوفر. فعّله في إعدادات iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf Mikrofon oder Spracherkennung fehlt. Aktiviere ihn in den iOS-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el permiso de micrófono o de reconocimiento de voz. Actívalo en los Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro ou à la reconnaissance vocale manque. Active-le dans les Réglages iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन या वाक् पहचान की अनुमति नहीं है। iOS सेटिंग्स में चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca il permesso per microfono o riconoscimento vocale. Attivalo nelle Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクまたは音声認識へのアクセスがありません。iOS の設定で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 또는 음성 인식 권한이 없습니다. iOS 설정에서 허용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do mikrofonu lub rozpoznawania mowy. Włącz go w Ustawieniach iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta permissão de microfone ou de reconhecimento de fala. Ative nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступа к микрофону или распознаванию речи. Включите его в настройках iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon veya konuşma tanıma izni eksik. iOS Ayarları’ndan aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає доступу до мікрофона або розпізнавання мовлення. Увімкніть його в Параметрах iOS."
          }
        },
        "zh-Hans" : {
