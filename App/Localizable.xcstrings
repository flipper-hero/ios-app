{
  "sourceLanguage" : "en",
  "strings" : {
    "Choose a model with tool calling. Images require vision support.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Modell mit Werkzeugaufrufen. Für Bilder muss es Bildverarbeitung unterstützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle avec appel d’outils. Les images nécessitent la prise en charge de la vision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modelo con llamadas a herramientas. Las imágenes requieren soporte de visión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um modelo com chamadas de ferramentas. Imagens exigem suporte visual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello con chiamate agli strumenti. Le immagini richiedono supporto visivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модель с вызовом инструментов. Для изображений нужна поддержка зрения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть модель із викликом інструментів. Для зображень потрібна підтримка зору."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz model obsługujący wywołania narzędzi. Obrazy wymagają obsługi wizji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç çağrılarını destekleyen bir model seçin. Görseller için görüntü desteği gerekir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا يدعم استدعاء الأدوات. تتطلب الصور دعم الرؤية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल कॉल वाला मॉडल चुनें। चित्रों के लिए दृष्टि समर्थन आवश्यक है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择支持工具调用的模型。图片需要视觉支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール呼び出しに対応したモデルを選んでください。画像には視覚機能が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 호출을 지원하는 모델을 선택하세요. 이미지에는 비전 지원이 필요합니다."
          }
        }
      }
    },
