    "Read files, check the device, make changes you approve." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ الملفات ويفحص الجهاز ويجري التغييرات التي توافق عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien lesen, das Gerät prüfen, Änderungen nach deiner Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee archivos, revisa el dispositivo y hace los cambios que apruebes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire des fichiers, vérifier l’appareil, faire les modifications que tu approuves."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें पढ़ें, डिवाइस जाँचें, आपकी स्वीकृति से बदलाव करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge file, controlla il dispositivo, fa le modifiche che approvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを読み、デバイスを確認し、承認した変更を行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 읽고, 기기를 확인하고, 승인한 변경을 수행합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyta pliki, sprawdza urządzenie i wprowadza zmiany, które zatwierdzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê arquivos, verifica o dispositivo e faz as mudanças que você aprovar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читает файлы, проверяет устройство и вносит изменения с вашего подтверждения."
