      }
    },
    "The agent is asking for fewer prompts. You can turn this off again at any time in Settings or by asking the agent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب الوكيل تقليل طلبات الموافقة. يمكنك إيقاف ذلك في أي وقت من الإعدادات أو بطلبه من الوكيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent möchte seltener nachfragen. Du kannst das jederzeit in den Einstellungen oder per Bitte an den Agenten wieder abschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente pide menos confirmaciones. Puedes desactivarlo en cualquier momento en Ajustes o pidiéndoselo al agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent demande moins de confirmations. Tu peux désactiver cela à tout moment dans les Réglages ou en le demandant à l’agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट कम पुष्टि माँगना चाहता है। आप इसे कभी भी सेटिंग्स में या एजेंट से कहकर बंद कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agente chiede meno conferme. Puoi disattivarlo in qualsiasi momento nelle Impostazioni o chiedendolo all’agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが確認を減らすよう求めています。設定から、またはエージェントに頼めば、いつでもオフに戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 확인 요청을 줄이려고 합니다. 언제든지 설정에서 또는 에이전트에게 요청해 다시 끌 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent prosi o rzadsze pytania. Możesz to wyłączyć w każdej chwili w Ustawieniach lub prosząc agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente está pedindo menos confirmações. Você pode desligar isso a qualquer momento nos Ajustes ou pedindo ao agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент просит реже спрашивать подтверждение. Это можно выключить в любой момент в настройках или попросив агента."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajan daha az onay istemek istiyor. Bunu istediğin zaman Ayarlar’dan ya da ajandan isteyerek kapatabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент просить рідше питати підтвердження. Це можна вимкнути будь-коли в Параметрах або попросивши агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体请求减少确认。你随时可以在设置中或通过让智能体关闭它。"
          }
        }
      }
    },
