    "Emulating %@. Stop it from the Lock Screen or say “Stop Flipper App”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ محاكاة %@. أوقفها من شاشة القفل أو قل \"إيقاف تطبيق Flipper\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuliere %@. Stoppe es auf dem Sperrbildschirm oder sag „Flipper-App stoppen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulando %@. Detenlo desde la pantalla bloqueada o di «Detener app de Flipper»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émulation de %@. Arrête-la depuis l’écran verrouillé ou dis « Arrêter l’app Flipper »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एमुलेट हो रहा है। लॉक स्क्रीन से रोकें या कहें \"Flipper ऐप रोकें\"।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulazione di %@. Fermala dalla schermata di blocco o di’ «Ferma app Flipper»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をエミュレート中。ロック画面で停止するか、「Flipper アプリを停止」と話しかけてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 에뮬레이트 중. 잠금 화면에서 중지하거나 \"Flipper 앱 중지\"라고 말하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulowanie %@. Zatrzymaj je na ekranie blokady lub powiedz „Zatrzymaj aplikację Flipper”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulando %@. Pare pela Tela Bloqueada ou diga \"Parar app do Flipper\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмуляция %@. Остановите её на экране блокировки или скажите «Остановить приложение Flipper»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ taklit ediliyor. Kilit Ekranı’ndan durdur ya da “Flipper uygulamasını durdur” de."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Емуляція %@. Зупиніть її на замкненому екрані або скажіть «Зупинити застосунок Flipper»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在模拟 %@。可在锁定屏幕上停止，或说“停止 Flipper 应用”。"
          }
        }
      }
    },
